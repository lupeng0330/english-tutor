# 后端环境变量模板（复制为 .env 后填写）

# 数据库：本地开发用 SQLite（零依赖）；生产切 PostgreSQL
# 本地：DATABASE_URL="file:./dev.db"
# 生产：DATABASE_URL="postgresql://user:pass@host:5432/dbname?schema=public"
DATABASE_URL="file:./dev.db"

# 服务端口
PORT=4000

# JWT 密钥（生产必须改成强随机值）
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="30d"

# 首个管理员账号（seed 用）
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="admin123456"

# CORS 允许来源（逗号分隔；管理后台 / 学习端）
CORS_ORIGINS="http://localhost:5173,http://localhost:8765"
