#!/bin/bash
# 腾讯云函数 Web 版启动脚本（CloudBase 云函数 Node 运行时入口）
# Web 函数固定要求监听 9000 端口
export PORT=9000
# 数据库：优先用平台环境变量注入的 PostgreSQL 连接串（Supabase 免费档，持久化）；
# 未注入时回退 /tmp SQLite（实例回收即丢数据，仅作降级兜底，保证服务可启动）。
export DATABASE_URL="${DATABASE_URL:-file:/tmp/dev.db}"
export NODE_ENV=production
# 线上前端域名（GitHub Pages）+ 本地开发
export CORS_ORIGINS="https://lupeng0330.github.io,http://localhost:8765,http://127.0.0.1:8765"

# 冷启动建表（幂等；用 PrismaClient 执行 init.sql，不依赖平台相关的 prisma CLI）
node scripts/init-db.js || true

# 冷启动种子（幂等）：管理员 + 权益点 + 默认套餐 + 系统设置
# /tmp 的 SQLite 实例回收即清空，不种数据的话线上「会员中心」会永远是空套餐、且没有 admin 账号。
# 已存在的 admin 不会被重置密码（seed-core 默认 resetAdminPassword=false）。
node scripts/seed-core.js || true

# 启动编译产物
node dist/server.js
